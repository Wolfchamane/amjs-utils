{
    "name": "@amjs/js-utils",
    "version": "0.6.1",
    "description": "Collection of ES6+ (JS) ESM tools",
    "keywords": [
        "javascript",
        "esm",
        "tools",
        "web",
        "development"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Wolfchamane/amjs-js-utils/issues"
    },
    "homepage": "https://github.com/Wolfchamane/amjs-js-utils",
    "repository": {
        "type": "git",
        "ulr": "git@github.com:Wolfchamane/amjs-js-utils.git"
    },
    "author": "Arturo Martínez Díaz <arturo.martinez@amartinez.dev>",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@vitest/coverage-v8": "^4.1.5",
        "eslint": "^9.21.0",
        "globals": "^16.0.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.5.0",
        "ts-node": "^10.9.2",
        "typedoc": "^0.27.9",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.26.0",
        "vitest": "^4.1.11"
    },
    "scripts": {
        "build": "tsc",
        "build:doc": "typedoc --tsconfig tsconfig.json --options typedoc.config.js",
        "lint": "npm run format:check && npm run lint:check && npm run type:check && npm run test:coverage",
        "format:check": "prettier --config .prettierrc --check .",
        "format:fix": "prettier --config .prettierrc --write .",
        "lint:check": "eslint --config eslint.config.js src/**/*.ts ",
        "lint:fix": "eslint --fix --config eslint.config.js src/**/*.ts",
        "test": "vitest",
        "test:coverage": "vitest --coverage",
        "type:check": "tsc --noEmit"
    }
}
